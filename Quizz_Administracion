  <script>
    (() => {
      const questions = [
        { question:"¿Qué nivel de innovación representa la compra de un boleto mediante un código QR estático?", options:["Poco innovador","Innovador","Muy innovador","Disruptivo"] },
        { question:"¿Cómo considera la función de un boleto interactivo que cambie en tiempo real para mostrar promociones y avisos?", options:["Aún es muy tradicional","Poco innovador","Muy innovador","Disruptivo"] },
        { question:"Reasignación automática a un mejor asiento (Seat Upgrade) antes de la función.", options:["Aún es convencional","Poco atractiva","Innovadora","Muy innovadora"] },
        { question:"¿Qué tan innovador consideras transformar los boletos en insignias y pósteres digitales coleccionables?", options:["Sin innovación","Poco innovador","Algo innovador","Muy innovador"] },
        { question:"El uso de cupones de dulcería que cambian según la influencia del cine es una propuesta:", options:["Común","Algo innovadora","Muy innovadora","Disruptiva"] },
        { question:"Acumular puntos por llegar a tiempo a la sala de cine se considera una función:", options:["Estándar","Poco innovadora","Innovadora","Muy innovadora"] },
        { question:"El modo "Cine Automático" que atenúa la pantalla del teléfono al iniciar la película es:", options:["Una innovación","Poco relevante","Moderadamente útil","Útil"] },
        { question:"Recibir notificaciones personalizadas según tus películas favoritas muestra un nivel de innovación:", options:["Básico","Poco innovador","Aceptable","Muy innovador"] },
        { question:"Desbloquear preventas exclusivas tras juntar una colección de pases de una saga es:", options:["Tradicional","Ligeramente novedoso","Innovador","Muy innovador"] },
        { question:"Tener un modelo digital integrado que premia el uso continuo de la app es:", options:["Muy común","Poco innovador","Innovador","Muy útil e innovador"] },
        { question:"Comparado con las aplicaciones de cine tradicionales, este producto es:", options:["IDÉNTICO","Poco diferente","Poco superior","Muy innovador"] },
        { question:"Sustituir por completo la necesidad de ir a la taquilla física representa un cambio:", options:["Mínimo","Ligeramente práctico","Relevante","Transformador"] },
        { question:"¿Qué tan innovador es integrar inteligencia artificial para sugerir cambios de dulcería personalizados?", options:["Poco innovador","Algo común","Innovador","Súper avanzada"] },
        { question:"Un sistema anti-duplicación con códigos QR dinámicos que cambian cada 15 segundos es:", options:["Básico","Poco novedoso","Muy innovador","Estándar máximo de seguridad"] },
        { question:"Ofrecer una recompensa sorpresa al escanear la entrada al cine se percibe como:", options:["Rutinario","Poco atractivo","Interesante","Muy innovador"] },
        { question:"La capacidad de gestionar el boleto y la dulcería desde una sola interfaz se evalúa como:", options:["Común","Práctica","Innovación moderada","Muy innovadora"] },
        { question:"Integrar un sistema de calificación y retroalimentación dentro del mismo boleto digital es:", options:["Básico","Poco innovador","Útil e innovador","Muy innovador"] },
        { question:"La opción de regalar o transferir pases coleccionables entre usuarios dentro de la app es:", options:["Frecuente","Poco atractiva","Poco innovadora","Muy innovadora"] },
        { question:"El impacto general de la plataforma CINETIKIX en la industria cinematográfica se considera:", options:["Nulo","Bajo","Medio","Alto e innovador"] },
        { question:"En general, ¿cómo clasificarías la propuesta global de innovación de Smart Pass AI?", options:["No innovadora","Poco innovadora","Moderadamente innovadora","Muy innovadora"] }
      ];
      const TOTAL = questions.length;
      const $ = id => document.getElementById(id);
      const views = ['intro','quiz','review','done'];
      let answers = Array(TOTAL).fill(null);
      let participant = '';
      let current = 0;
      let ready = false;
      let submitting = false;

      function show(view) {
        views.forEach(id => { $(id).hidden = id !== view; });
        $(view).scrollIntoView({behavior:'smooth',block:'start'});
      }
      function error(id, message) { $(id).textContent = message; }

      function renderQuestion() {
        $('progress-label').textContent = `Pregunta ${current + 1} de ${TOTAL}`;
        $('participant-label').textContent = participant;
        $('progress').setAttribute('aria-valuenow', String(current + 1));
        $('progress-fill').style.width = `${(current + 1) / TOTAL * 100}%`;
        $('question-title').textContent = `${current + 1}. ${questions[current].question}`;
        const list = $('option-list');
        list.replaceChildren();
        questions[current].options.forEach((text, index) => {
          const label = document.createElement('label');
          label.className = 'option';
          const radio = document.createElement('input');
          radio.type = 'radio';
          radio.name = 'answer';
          radio.value = String(index);
          radio.checked = answers[current] === index;
          radio.addEventListener('change', () => {
            answers[current] = index;
            error('quiz-error','');
          });
          const caption = document.createElement('span');
          caption.textContent = text;
          label.append(radio, caption);
          list.append(label);
        });
        $('back-button').hidden = current === 0;
        $('next-button').hidden = current === TOTAL - 1;
        $('review-button').hidden = current !== TOTAL - 1;
        error('quiz-error','');
      }

      function summary(listId, nameId) {
        $(nameId).textContent = `Nombre: ${participant}`;
        const list = $(listId);
        list.replaceChildren();
        questions.forEach((q, i) => {
          const item = document.createElement('li');
          item.className = 'rounded-xl bg-[#f4faf7] border border-[#dce9e5] px-4 py-3';
          const title = document.createElement('strong');
          title.className = 'block';
          title.textContent = `${i + 1}. ${q.question}`;
          const answer = document.createElement('span');
          answer.className = 'block mt-1 text-[#52696a]';
          answer.textContent = q.options[answers[i]];
          item.append(title, answer);
          list.append(item);
        });
      }

      $('start-form').addEventListener('submit', event => {
        event.preventDefault();
        const name = $('name').value.trim();
        if (!name) {
          error('start-error','Ingresa tu nombre para continuar.');
          $('name').focus();
          return;
        }
        error('start-error','');
        participant = name;
        current = 0;
        renderQuestion();
        show('quiz');
        $('question-title').focus();
      });
      $('back-button').addEventListener('click', () => {
        if (current > 0) { current--; renderQuestion(); }
      });
      function advance() {
        if (answers[current] === null) {
          error('quiz-error','Selecciona una respuesta antes de continuar.');
          $('option-list').querySelector('input')?.focus();
          return;
        }
        if (current < TOTAL - 1) {
          current++;
          renderQuestion();
        } else {
          summary('review-list','review-name');
          show('review');
          $('review-heading').focus();
        }
      }
      $('next-button').addEventListener('click', advance);
      $('review-button').addEventListener('click', advance);
      $('review-back').addEventListener('click', () => {
        renderQuestion();
        show('quiz');
        $('question-title').focus();
      });
      $('submit-button').addEventListener('click', async () => {
        if (submitting) return;
        if (!ready) {
          error('submit-error','No se pudo conectar con Canva Sheets. Inténtalo de nuevo más tarde.');
          return;
        }
        submitting = true;
        $('submit-button').disabled = true;
        $('submit-label').hidden = true;
        $('submitting-label').hidden = false;
        error('submit-error','');
        try {
          const respuestas = questions.map((q,i) => ({
            numero:i + 1, pregunta:q.question, respuesta:q.options[answers[i]]
          }));
          const result = await window.dataSdk.create({
            nombre:participant,
            respuestas:JSON.stringify(respuestas),
            fecha:new Date().toISOString()
          });
          if (!result.isOk) throw new Error('No se pudo guardar');
          summary('done-list','done-name');
          show('done');
          $('done-heading').focus();
        } catch (_) {
          error('submit-error','No se pudieron guardar las respuestas. Comprueba la conexión e inténtalo de nuevo.');
        } finally {
          submitting = false;
          $('submit-button').disabled = false;
          $('submit-label').hidden = false;
          $('submitting-label').hidden = true;
        }
      });
      $('reset-button').addEventListener('click', () => {
        answers = Array(TOTAL).fill(null);
        participant = '';
        current = 0;
        $('name').value = '';
        error('start-error','');
        error('submit-error','');
        show('intro');
        $('name').focus();
      });
      (async () => {
        try {
          const result = await window.dataSdk.init({onDataChanged() {}});
          ready = result.isOk;
        } catch (_) { ready = false; }
      })();
    })();
  </script>
 
</body></html>
